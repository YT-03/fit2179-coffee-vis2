{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "From $2 Billion to $7 Billion",
    "subtitle": "Bars show industry revenue. The dark line tracks year-on-year growth rate — falling sharply in 2020, then rebounding in 2022.",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "anchor": "start"
  },
  "width": 600,
  "height": 350,
  "data": {
    "url": "https://raw.githubusercontent.com/YT-03/fit2179-coffee-vis2/main/data/industry_revenue.csv"
  },
  "transform": [
    {
      "window": [{"op": "lag", "field": "Revenue_BAUD", "as": "prev_revenue"}],
      "sort": [{"field": "Year"}]
    },
    {
      "calculate": "datum.prev_revenue ? ((datum.Revenue_BAUD - datum.prev_revenue) / datum.prev_revenue) * 100 : null",
      "as": "growth_pct"
    }
  ],
  "layer": [
    {
      "mark": {"type": "bar", "color": "#A0785A", "cornerRadiusEnd": 3},
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal",
          "title": null,
          "axis": {"labelAngle": 0, "labelFontSize": 11}
        },
        "y": {
          "field": "Revenue_BAUD",
          "type": "quantitative",
          "axis": {
            "title": "Revenue (AUD billions)",
            "titleColor": "#6F4E37",
            "labelColor": "#6F4E37",
            "format": "$.1f"
          }
        },
        "tooltip": [
          {"field": "Year", "type": "ordinal"},
          {"field": "Revenue_BAUD", "type": "quantitative", "title": "Revenue ($B)", "format": ".1f"},
          {"field": "growth_pct", "type": "quantitative", "title": "Growth vs prev (%)", "format": ".1f"}
        ]
      }
    },
    {
      "mark": {"type": "line", "color": "#3C2415", "strokeWidth": 2.5, "interpolate": "monotone"},
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal"
        },
        "y": {
          "field": "growth_pct",
          "type": "quantitative",
          "axis": {
            "title": "Growth rate (%)",
            "titleColor": "#3C2415",
            "labelColor": "#3C2415",
            "format": ".0f",
            "orient": "right",
            "grid": false
          }
        }
      }
    },
    {
      "mark": {"type": "point", "color": "#3C2415", "size": 60, "filled": true},
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal"
        },
        "y": {
          "field": "growth_pct",
          "type": "quantitative",
          "axis": null
        }
      }
    }
  ],
  "resolve": {"scale": {"y": "independent"}}
}