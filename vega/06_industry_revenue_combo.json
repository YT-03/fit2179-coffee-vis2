{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "From $2 Billion to $7 Billion (2004–2026)",
    "subtitle": "Bars show industry revenue. The dark line tracks growth rate — falling sharply in 2020, then rebounding strongly in 2022.",
    "fontSize": 15,
    "subtitleFontSize": 11,
    "anchor": "start",
    "color": "#3C2415",
    "subtitleColor": "#6F4E37",
    "font": "Georgia, serif",
    "subtitleFont": "Helvetica, sans-serif"
  },
  "autosize": {"type": "fit-x", "contains": "padding"},
  "width": 700,
  "height": 320,
  "data": {
    "url": "https://raw.githubusercontent.com/YT-03/fit2179-coffee-vis2/main/data/industry_revenue.csv"
  },
  "transform": [
    {
      "window": [{"op": "lag", "field": "Revenue_BAUD", "as": "prev_revenue"}],
      "sort": [{"field": "Year"}]
    },
    {
      "calculate": "datum.prev_revenue ? ((datum.Revenue_BAUD - datum.prev_revenue) / datum.prev_revenue) * 100 : null",
      "as": "growth_pct"
    }
  ],
  "layer": [
    {
      "mark": {"type": "bar", "color": "#C49B7D", "cornerRadiusEnd": 3},
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal",
          "title": null,
          "axis": {"labelAngle": 0, "labelFontSize": 11}
        },
        "y": {
          "field": "Revenue_BAUD",
          "type": "quantitative",
          "axis": {
            "title": "Revenue (AUD billions)",
            "titleColor": "#6F4E37",
            "labelColor": "#6F4E37",
            "format": "$.1f",
            "titleFontSize": 12,
            "grid": true,
            "gridColor": "#f0e0cc"
          }
        },
        "tooltip": [
          {"field": "Year", "type": "ordinal", "title": "Year"},
          {"field": "Revenue_BAUD", "type": "quantitative", "title": "Revenue ($B AUD)", "format": ".1f"},
          {"field": "growth_pct", "type": "quantitative", "title": "Growth vs prior period (%)", "format": ".1f"}
        ]
      }
    },
    {
      "mark": {"type": "line", "color": "#3C2415", "strokeWidth": 2.5, "interpolate": "monotone"},
      "encoding": {
        "x": {"field": "Year", "type": "ordinal"},
        "y": {
          "field": "growth_pct",
          "type": "quantitative",
          "axis": {
            "title": "Growth rate (%)",
            "titleColor": "#3C2415",
            "labelColor": "#3C2415",
            "format": ".0f",
            "orient": "right",
            "grid": false,
            "titleFontSize": 12
          }
        }
      }
    },
    {
      "mark": {"type": "point", "color": "#3C2415", "size": 60, "filled": true},
      "encoding": {
        "x": {"field": "Year", "type": "ordinal"},
        "y": {"field": "growth_pct", "type": "quantitative", "axis": null}
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "dy": -10,
        "fontSize": 9,
        "fontStyle": "italic",
        "fontWeight": "bold",
        "color": "#A0785A"
      },
      "data": {"values": [{"yr": "2020", "label": "↓ COVID-19"}]},
      "encoding": {
        "x": {"field": "yr", "type": "ordinal"},
        "text": {"field": "label", "type": "nominal"}
      }
    }
  ],
  "resolve": {"scale": {"y": "independent"}},
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "font": "Georgia, serif"
  }
}