{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where Australia's Coffee Comes From",
    "subtitle": "Brazil supplies nearly a third of all imports, followed by Vietnam and Colombia.",
    "fontSize": 15,
    "subtitleFontSize": 11,
    "anchor": "start",
    "color": "#3C2415",
    "subtitleColor": "#6F4E37",
    "font": "Georgia, serif",
    "subtitleFont": "Helvetica, sans-serif"
  },
  "autosize": {"type": "fit-x", "contains": "padding"},
  "width": 520,
  "height": 360,
  "data": {
    "url": "https://raw.githubusercontent.com/YT-03/fit2179-coffee-vis2/main/data/import_origins.csv"
  },
  "encoding": {
    "y": {
      "field": "Country",
      "type": "nominal",
      "sort": ["Brazil", "Vietnam", "Colombia", "Ethiopia", "Indonesia", "Papua New Guinea", "Other"],
      "title": null,
      "axis": {"labelFontSize": 13, "labelColor": "#3C2415", "labelFont": "Helvetica, sans-serif", "ticks": false, "domain": false}
    },
    "color": {
      "field": "Country",
      "type": "nominal",
      "scale": {
        "domain": ["Brazil", "Vietnam", "Colombia", "Ethiopia", "Indonesia", "Papua New Guinea", "Other"],
        "range": ["#8B2500", "#3A7D52", "#D4860A", "#8B4513", "#2E6EA6", "#7B4FA0", "#888888"]
      },
      "legend": {
        "title": "Country",
        "orient": "right",
        "titleColor": "#3C2415",
        "titleFont": "Georgia, serif",
        "titleFontSize": 12,
        "titleFontWeight": "bold",
        "labelColor": "#3C2415",
        "labelFont": "Helvetica, sans-serif",
        "labelFontSize": 11
      }
    }
  },
  "layer": [
    {
      "mark": {"type": "rule", "strokeWidth": 3},
      "encoding": {
        "x": {
          "field": "Share_Percent",
          "type": "quantitative",
          "title": "Share of imports (%)",
          "scale": {"domain": [0, 38]},
          "axis": {"grid": true, "gridColor": "#f0e0cc", "labelFontSize": 11, "titleFontSize": 12, "labelColor": "#3C2415", "titleColor": "#3C2415", "labelFont": "Helvetica, sans-serif"}
        },
        "x2": {"datum": 0}
      }
    },
    {
      "mark": {"type": "circle", "opacity": 1, "size": 220},
      "encoding": {
        "x": {"field": "Share_Percent", "type": "quantitative"},
        "tooltip": [
          {"field": "Country", "type": "nominal", "title": "Country"},
          {"field": "Share_Percent", "type": "quantitative", "title": "Share (%)"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 14,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#3C2415",
        "font": "Helvetica, sans-serif"
      },
      "encoding": {
        "x": {"field": "Share_Percent", "type": "quantitative"},
        "text": {"field": "Share_Percent", "type": "quantitative", "format": ".0f"}
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "font": "Georgia, serif"
  }
}