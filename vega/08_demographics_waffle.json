{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Daily Coffee Drinkers by Age Group",
    "subtitle": "Percentage of Australians who drink coffee every day, by generation.",
    "fontSize": 15,
    "subtitleFontSize": 11,
    "anchor": "start",
    "color": "#3C2415",
    "subtitleColor": "#6F4E37",
    "font": "Georgia, serif",
    "subtitleFont": "Helvetica, sans-serif"
  },
  "autosize": {"type": "fit-x", "contains": "padding"},
  "width": 520,
  "height": 320,
  "data": {
    "url": "https://raw.githubusercontent.com/YT-03/fit2179-coffee-vis2/main/data/consumer_demographics.csv"
  },
  "layer": [
    {
      "mark": {"type": "bar", "cornerRadiusEnd": 5},
      "encoding": {
        "y": {
          "field": "Age_Group",
          "type": "nominal",
          "sort": ["18-24", "25-34", "35-44", "45-54", "55-64", "65+"],
          "title": "Age group",
          "axis": {
            "labelFontSize": 13,
            "labelColor": "#3C2415",
            "labelFont": "Helvetica, sans-serif",
            "titleFontSize": 12,
            "titleColor": "#3C2415",
            "ticks": false,
            "domain": false
          }
        },
        "x": {
          "field": "Daily_Drinkers_Percent",
          "type": "quantitative",
          "title": "Daily drinkers (%)",
          "scale": {"domain": [0, 85]},
          "axis": {
            "labelFontSize": 11,
            "titleFontSize": 12,
            "labelColor": "#3C2415",
            "titleColor": "#3C2415",
            "labelFont": "Helvetica, sans-serif",
            "grid": true,
            "gridColor": "#f0e0cc"
          }
        },
        "color": {
          "field": "Daily_Drinkers_Percent",
          "type": "quantitative",
          "scale": {
            "domain": [50, 75],
            "range": ["#C49B7D", "#3C2415"]
          },
          "legend": null
        },
        "tooltip": [
          {"field": "Age_Group", "type": "nominal", "title": "Age group"},
          {"field": "Daily_Drinkers_Percent", "type": "quantitative", "title": "Daily drinkers (%)"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 6,
        "fontSize": 12,
        "fontWeight": "bold",
        "font": "Helvetica, sans-serif",
        "color": "#3C2415"
      },
      "encoding": {
        "y": {
          "field": "Age_Group",
          "type": "nominal",
          "sort": ["18-24", "25-34", "35-44", "45-54", "55-64", "65+"]
        },
        "x": {"field": "Daily_Drinkers_Percent", "type": "quantitative"},
        "text": {
          "field": "Daily_Drinkers_Percent",
          "type": "quantitative",
          "format": ".0f"
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "strokeDash": [5, 4],
        "color": "#8B5A3C",
        "strokeWidth": 2
      },
      "data": {"values": [{"avg": 66}]},
      "encoding": {
        "x": {"field": "avg", "type": "quantitative"}
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "dy": -8,
        "fontSize": 11,
        "fontStyle": "italic",
        "fontWeight": "bold",
        "font": "Helvetica, sans-serif",
        "color": "#8B5A3C"
      },
      "data": {"values": [{"avg": 66, "label": "National avg: 66%"}]},
      "encoding": {
        "x": {"field": "avg", "type": "quantitative"},
        "text": {"field": "label", "type": "nominal"}
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "font": "Georgia, serif"
  }
}