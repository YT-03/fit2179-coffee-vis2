{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Coffee Through the Generations",
    "subtitle": "Each row = 10 people. Dark circles = daily drinkers. Light circles = non-daily drinkers.",
    "fontSize": 15,
    "subtitleFontSize": 11,
    "anchor": "start",
    "color": "#3C2415",
    "subtitleColor": "#6F4E37",
    "font": "Georgia, serif",
    "subtitleFont": "Helvetica, sans-serif"
  },
  "autosize": {"type": "fit-x", "contains": "padding"},
  "width": 560,
  "height": 380,
  "data": {
    "url": "https://raw.githubusercontent.com/YT-03/fit2179-coffee-vis2/main/data/demographics_waffle.csv"
  },
  "transform": [
    {
      "lookup": "Age_Group",
      "from": {
        "data": {
          "url": "https://raw.githubusercontent.com/YT-03/fit2179-coffee-vis2/main/data/consumer_demographics.csv"
        },
        "key": "Age_Group",
        "fields": ["Daily_Drinkers_Percent"]
      }
    }
  ],
  "mark": {"type": "circle", "opacity": 0.92},
  "encoding": {
    "x": {
      "field": "cup",
      "type": "ordinal",
      "axis": null
    },
    "y": {
      "field": "Age_Group",
      "type": "nominal",
      "sort": ["18-24", "25-34", "35-44", "45-54", "55-64", "65+"],
      "title": null,
      "axis": {
        "labelFontSize": 14,
        "labelColor": "#3C2415",
        "labelFont": "Helvetica, sans-serif",
        "labelPadding": 16,
        "ticks": false,
        "domain": false
      }
    },
    "size": {"value": 420},
    "color": {
      "field": "filled",
      "type": "nominal",
      "scale": {"domain": [1, 0], "range": ["#6F4E37", "#DDD0BC"]},
      "legend": {
        "title": null,
        "orient": "bottom",
        "direction": "horizontal",
        "labelExpr": "datum.value === '1' ? 'Daily coffee drinker' : 'Non-daily drinker'",
        "labelColor": "#3C2415",
        "labelFont": "Helvetica, sans-serif",
        "labelFontSize": 12,
        "symbolSize": 150
      }
    },
    "tooltip": [
      {"field": "Age_Group", "type": "nominal", "title": "Age group"},
      {"field": "Daily_Drinkers_Percent", "type": "quantitative", "title": "Daily drinkers (%)"}
    ]
  },
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "font": "Georgia, serif"
  }
}