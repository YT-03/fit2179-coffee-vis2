{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 340,
  "height": 340,
  "data": {
    "url": "https://raw.githubusercontent.com/YT-03/fit2179-coffee-vis2/main/data/coffee_preferences.csv"
  },
  "transform": [
    {"calculate": "datum.Percent + '%'", "as": "label"}
  ],
  "encoding": {
    "theta": {"field": "Percent", "type": "quantitative", "stack": true},
    "order": {"field": "Percent", "type": "quantitative", "sort": "descending"}
  },
  "layer": [
    {
      "mark": {"type": "arc", "innerRadius": 85, "outerRadius": 145, "stroke": "white", "strokeWidth": 2},
      "encoding": {
        "color": {
          "field": "Type",
          "type": "nominal",
          "sort": {"field": "Percent", "order": "descending"},
          "scale": {
            "domain": ["Latte", "Flat White", "Cappuccino", "Long Black", "Espresso", "Cold Brew", "Other"],
            "range": ["#6F4E37", "#A0785A", "#C49B7D", "#8B5A3C", "#5D3A1F", "#D4A96A", "#E8D4B8"]
          },
          "legend": {
            "title": "Coffee type",
            "titleColor": "#3C2415",
            "titleFont": "Georgia, serif",
            "titleFontSize": 12,
            "titleFontWeight": "bold",
            "labelColor": "#3C2415",
            "labelFont": "Helvetica, sans-serif",
            "labelFontSize": 11,
            "orient": "right"
          }
        },
        "tooltip": [
          {"field": "Type", "type": "nominal", "title": "Coffee"},
          {"field": "Percent", "type": "quantitative", "title": "Share (%)"}
        ]
      }
    },
    {
      "mark": {"type": "text", "radius": 168, "fontSize": 11, "fontWeight": "bold", "color": "#3C2415", "font": "Helvetica, sans-serif"},
      "encoding": {
        "text": {"field": "label", "type": "nominal"}
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 34,
        "fontWeight": "bold",
        "font": "Georgia, serif",
        "color": "#3C2415",
        "dy": -14,
        "align": "center",
        "baseline": "middle"
      },
      "data": {"values": [{}]},
      "encoding": {"text": {"value": "52%"}}
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11,
        "font": "Helvetica, sans-serif",
        "color": "#6F4E37",
        "dy": 16,
        "align": "center",
        "baseline": "middle"
      },
      "data": {"values": [{}]},
      "encoding": {"text": {"value": "Latte & Flat White"}}
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "font": "Georgia, serif"
  }
}