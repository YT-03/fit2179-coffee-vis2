{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The Price of a Flat White",
    "subtitle": "Sydney leads on price; Hobart still offers the cheapest cup in the country.",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "anchor": "start"
  },
  "width": 500,
  "height": 280,
  "data": {
    "url": "https://raw.githubusercontent.com/YT-03/fit2179-coffee-vis2/main/data/flat_white_price.csv"
  },
  "layer": [
    {
      "mark": {"type": "bar", "cornerRadiusEnd": 4},
      "encoding": {
        "y": {
          "field": "City",
          "type": "nominal",
          "sort": "-x",
          "title": null,
          "axis": {"labelFontSize": 12}
        },
        "x": {
          "field": "Price_AUD",
          "type": "quantitative",
          "title": "Price (AUD)",
          "axis": {"format": "$.2f"}
        },
        "color": {
          "field": "Price_AUD",
          "type": "quantitative",
          "scale": {"scheme": "browns"},
          "legend": null
        },
        "tooltip": [
          {"field": "City", "type": "nominal"},
          {"field": "Price_AUD", "type": "quantitative", "title": "Price", "format": "$.2f"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 5,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#3C2415"
      },
      "encoding": {
        "y": {"field": "City", "type": "nominal", "sort": "-x"},
        "x": {"field": "Price_AUD", "type": "quantitative"},
        "text": {"field": "Price_AUD", "type": "quantitative", "format": "$.2f"}
      }
    }
  ]
}