{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "autosize": {"type": "fit-x", "contains": "padding"},
  "width": 420,
  "height": 300,
  "data": {
    "url": "https://raw.githubusercontent.com/YT-03/fit2179-coffee-vis2/main/data/flat_white_price.csv"
  },
  "layer": [
    {
      "mark": {"type": "bar", "cornerRadiusEnd": 4},
      "encoding": {
        "y": {
          "field": "City",
          "type": "nominal",
          "sort": "-x",
          "title": null,
          "axis": {"labelFontSize": 12, "labelColor": "#3C2415", "labelFont": "Helvetica, sans-serif", "ticks": false, "domain": false}
        },
        "x": {
          "field": "Price_AUD",
          "type": "quantitative",
          "title": "Price (AUD)",
          "scale": {"domain": [0, 6.2]},
          "axis": {"format": "$,.2f", "labelFontSize": 11, "titleFontSize": 12, "labelColor": "#3C2415", "titleColor": "#3C2415", "grid": true, "gridColor": "#f0e0cc", "labelFont": "Helvetica, sans-serif"}
        },
        "color": {
          "field": "Price_AUD",
          "type": "quantitative",
          "scale": {"scheme": "browns"},
          "legend": null
        },
        "tooltip": [
          {"field": "City", "type": "nominal", "title": "City"},
          {"field": "Price_AUD", "type": "quantitative", "title": "Price", "format": "$,.2f"}
        ]
      }
    },
    {
      "mark": {"type": "text", "align": "left", "baseline": "middle", "dx": 5, "fontSize": 11, "fontWeight": "bold", "color": "#3C2415", "font": "Helvetica, sans-serif"},
      "encoding": {
        "y": {"field": "City", "type": "nominal", "sort": "-x"},
        "x": {"field": "Price_AUD", "type": "quantitative"},
        "text": {"field": "Price_AUD", "type": "quantitative", "format": "$,.2f"}
      }
    },
    {
      "mark": {"type": "rule", "strokeDash": [6, 4], "color": "#2E6EA6", "strokeWidth": 2},
      "data": {"values": [{"avg": 4.93}]},
      "encoding": {
        "x": {"field": "avg", "type": "quantitative"}
      }
    },
    {
      "mark": {"type": "text", "align": "left", "dx": 5, "dy": 14, "fontSize": 11, "fontWeight": "bold", "font": "Helvetica, sans-serif", "color": "#2E6EA6"},
      "data": {"values": [{"avg": 4.93, "city": "Hobart", "label": "Nat. avg: $4.93"}]},
      "encoding": {
        "x": {"field": "avg", "type": "quantitative"},
        "y": {"field": "city", "type": "nominal", "sort": "-x"},
        "text": {"field": "label", "type": "nominal"}
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "font": "Georgia, serif"
  }
}