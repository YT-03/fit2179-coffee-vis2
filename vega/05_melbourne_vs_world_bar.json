{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "autosize": {"type": "fit-x", "contains": "padding"},
  "width": 480,
  "height": 300,
  "data": {
    "url": "https://raw.githubusercontent.com/YT-03/fit2179-coffee-vis2/main/data/melbourne_vs_world.csv"
  },
  "transform": [
    {"calculate": "datum.City === 'Melbourne' ? 'Melbourne' : 'Other'", "as": "is_melbourne"}
  ],
  "encoding": {
    "y": {
      "field": "City",
      "type": "nominal",
      "sort": ["Melbourne", "Vienna", "Rome", "Paris", "Sydney", "London", "New York", "Tokyo"],
      "title": null,
      "axis": {"labelFontSize": 12, "labelColor": "#3C2415", "labelFont": "Helvetica, sans-serif", "ticks": false, "domain": false}
    },
    "x": {
      "field": "Cafes_per_100k",
      "type": "quantitative",
      "title": "Cafés per 100,000 people",
      "scale": {"domain": [0, 340]},
      "axis": {"grid": true, "gridColor": "#f0e0cc", "labelFontSize": 11, "titleFontSize": 12, "labelColor": "#3C2415", "titleColor": "#3C2415", "labelFont": "Helvetica, sans-serif"}
    }
  },
  "layer": [
    {
      "mark": {"type": "bar", "cornerRadiusEnd": 4},
      "encoding": {
        "color": {
          "field": "is_melbourne",
          "type": "nominal",
          "scale": {"domain": ["Melbourne", "Other"], "range": ["#6F4E37", "#C49B7D"]},
          "legend": null
        },
        "tooltip": [
          {"field": "City", "type": "nominal", "title": "City"},
          {"field": "Cafes_per_100k", "type": "quantitative", "title": "Cafés per 100k"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 5,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#3C2415",
        "font": "Helvetica, sans-serif"
      },
      "encoding": {
        "text": {"field": "Cafes_per_100k", "type": "quantitative"}
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "font": "Georgia, serif"
  }
}