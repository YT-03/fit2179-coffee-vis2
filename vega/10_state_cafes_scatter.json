{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Population vs Café Density by State",
    "subtitle": "Larger population does not guarantee more cafés per capita. Bubble size = total cafés.",
    "fontSize": 15,
    "subtitleFontSize": 11,
    "anchor": "start",
    "color": "#3C2415",
    "subtitleColor": "#6F4E37",
    "font": "Georgia, serif",
    "subtitleFont": "Helvetica, sans-serif"
  },
  "autosize": {"type": "fit-x", "contains": "padding"},
  "width": 660,
  "height": 420,
  "data": {
    "url": "https://raw.githubusercontent.com/YT-03/fit2179-coffee-vis2/main/data/cafes_by_state.csv"
  },
  "transform": [
    {
      "calculate": "datum.State === 'NSW' ? 18 : datum.State === 'VIC' ? -20 : -16",
      "as": "lbl_dy"
    },
    {
      "calculate": "datum.State === 'NSW' ? -8 : 0",
      "as": "lbl_dx"
    }
  ],
  "layer": [
    {
      "mark": {"type": "point", "filled": true, "opacity": 0.88, "stroke": "white", "strokeWidth": 1.5},
      "encoding": {
        "x": {
          "field": "Population_M",
          "type": "quantitative",
          "title": "Population (millions)",
          "scale": {"zero": true, "domain": [0, 9.5]},
          "axis": {"labelFontSize": 11, "titleFontSize": 12, "titleColor": "#3C2415", "labelColor": "#3C2415", "labelFont": "Helvetica, sans-serif", "grid": true, "gridColor": "#f0e0cc"}
        },
        "y": {
          "field": "Cafes_per_100k",
          "type": "quantitative",
          "title": "Cafés per 100,000 people",
          "scale": {"zero": false, "domain": [100, 295]},
          "axis": {"labelFontSize": 11, "titleFontSize": 12, "titleColor": "#3C2415", "labelColor": "#3C2415", "labelFont": "Helvetica, sans-serif", "grid": true, "gridColor": "#f0e0cc"}
        },
        "size": {
          "field": "Cafes",
          "type": "quantitative",
          "scale": {"range": [80, 2000]},
          "legend": {
            "title": "Total cafés",
            "orient": "bottom",
            "direction": "horizontal",
            "titleColor": "#3C2415",
            "titleFont": "Georgia, serif",
            "titleFontSize": 12,
            "titleFontWeight": "bold",
            "labelColor": "#3C2415",
            "labelFont": "Helvetica, sans-serif",
            "labelFontSize": 11
          }
        },
        "color": {
          "field": "State",
          "type": "nominal",
          "scale": {
            "domain": ["NSW", "VIC", "QLD", "WA", "SA", "TAS", "ACT", "NT"],
            "range": ["#3C2415", "#6F4E37", "#A0785A", "#8B5A3C", "#C49B7D", "#D4A96A", "#5D3A1F", "#b8a080"]
          },
          "legend": null
        },
        "tooltip": [
          {"field": "State", "type": "nominal", "title": "State"},
          {"field": "Population_M", "type": "quantitative", "title": "Population (M)", "format": ".2f"},
          {"field": "Cafes_per_100k", "type": "quantitative", "title": "Cafés per 100k"},
          {"field": "Cafes", "type": "quantitative", "title": "Total cafés", "format": ","}
        ]
      }
    },
    {
      "mark": {"type": "text", "fontSize": 12, "fontWeight": "bold", "font": "Helvetica, sans-serif"},
      "encoding": {
        "x": {"field": "Population_M", "type": "quantitative"},
        "y": {"field": "Cafes_per_100k", "type": "quantitative"},
        "text": {"field": "State", "type": "nominal"},
        "dy": {"field": "lbl_dy", "type": "quantitative"},
        "dx": {"field": "lbl_dx", "type": "quantitative"},
        "color": {
          "field": "State",
          "type": "nominal",
          "scale": {
            "domain": ["NSW", "VIC", "QLD", "WA", "SA", "TAS", "ACT", "NT"],
            "range": ["#3C2415", "#3C2415", "#6F4E37", "#6F4E37", "#8B5A3C", "#8B5A3C", "#3C2415", "#888"]
          }
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "font": "Georgia, serif"
  }
}