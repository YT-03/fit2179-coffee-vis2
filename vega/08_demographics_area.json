{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Coffee Through the Generations",
    "subtitle": "Daily coffee drinking peaks in young working adulthood (25-34) and gradually declines after.",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "anchor": "start"
  },
  "width": 500,
  "height": 320,
  "data": {
    "url": "https://raw.githubusercontent.com/YT-03/fit2179-coffee-vis2/main/data/consumer_demographics.csv"
  },
  "encoding": {
    "x": {
      "field": "Age_Group",
      "type": "ordinal",
      "title": "Age group",
      "sort": ["18-24", "25-34", "35-44", "45-54", "55-64", "65+"],
      "axis": {"labelAngle": 0, "labelFontSize": 12}
    },
    "y": {
      "field": "Daily_Drinkers_Percent",
      "type": "quantitative",
      "title": "Daily coffee drinkers (%)",
      "scale": {"domain": [0, 80]}
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "color": "#A0785A",
        "opacity": 0.4,
        "interpolate": "monotone",
        "line": {"color": "#6F4E37", "strokeWidth": 3}
      }
    },
    {
      "mark": {"type": "point", "color": "#6F4E37", "size": 100, "filled": true},
      "encoding": {
        "tooltip": [
          {"field": "Age_Group", "type": "nominal", "title": "Age"},
          {"field": "Daily_Drinkers_Percent", "type": "quantitative", "title": "% who drink daily"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "bottom",
        "dy": -12,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#3C2415"
      },
      "encoding": {
        "text": {"field": "Daily_Drinkers_Percent", "type": "quantitative", "format": ".0f"}
      }
    }
  ]
}