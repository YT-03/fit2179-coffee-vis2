{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "autosize": {"type": "fit-x", "contains": "padding"},
  "width": 560,
  "height": 340,
  "data": {
    "url": "https://raw.githubusercontent.com/YT-03/fit2179-coffee-vis2/main/data/cafe_hourly_traffic.csv"
  },
  "transform": [
    {
      "calculate": "datum.Hour >= 7 && datum.Hour <= 10 ? 'Morning rush (7–10 am)' : (datum.Hour === 12 || datum.Hour === 13 ? 'Lunch bump (12–1 pm)' : 'Other hours')",
      "as": "period"
    }
  ],
  "layer": [
    {
      "mark": {"type": "bar", "cornerRadiusEnd": 3},
      "encoding": {
        "x": {
          "field": "Hour",
          "type": "ordinal",
          "title": "Hour of day",
          "sort": {"field": "Hour", "order": "ascending"},
          "axis": {
            "labelExpr": "datum.value === 0 ? '12am' : datum.value === 12 ? '12pm' : datum.value < 12 ? datum.value + 'am' : (datum.value - 12) + 'pm'",
            "labelAngle": -45,
            "labelFontSize": 10,
            "titleFontSize": 12,
            "labelColor": "#3C2415",
            "titleColor": "#3C2415",
            "labelFont": "Helvetica, sans-serif"
          }
        },
        "y": {
          "field": "Visits_Index",
          "type": "quantitative",
          "title": "Visit index (peak = 100)",
          "scale": {"domain": [0, 115]},
          "axis": {
            "labelFontSize": 11,
            "titleFontSize": 12,
            "labelColor": "#3C2415",
            "titleColor": "#3C2415",
            "labelFont": "Helvetica, sans-serif",
            "grid": true,
            "gridColor": "#f0e0cc"
          }
        },
        "color": {
          "field": "period",
          "type": "nominal",
          "scale": {
            "domain": ["Morning rush (7–10 am)", "Lunch bump (12–1 pm)", "Other hours"],
            "range": ["#3C2415", "#A0785A", "#D4C4A8"]
          },
          "legend": {
            "title": "Time of day",
            "orient": "bottom",
            "direction": "horizontal",
            "titleColor": "#3C2415",
            "titleFont": "Georgia, serif",
            "titleFontSize": 12,
            "titleFontWeight": "bold",
            "labelColor": "#3C2415",
            "labelFont": "Helvetica, sans-serif",
            "labelFontSize": 11
          }
        },
        "tooltip": [
          {"field": "Hour_Label", "type": "nominal", "title": "Hour"},
          {"field": "Visits_Index", "type": "quantitative", "title": "Visit index"},
          {"field": "period", "type": "nominal", "title": "Period"}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.Visits_Index >= 50"}],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "bottom",
        "dy": -4,
        "fontSize": 10,
        "fontWeight": "bold",
        "font": "Helvetica, sans-serif",
        "color": "#3C2415"
      },
      "encoding": {
        "x": {
          "field": "Hour",
          "type": "ordinal",
          "sort": {"field": "Hour", "order": "ascending"}
        },
        "y": {"field": "Visits_Index", "type": "quantitative"},
        "text": {"field": "Visits_Index", "type": "quantitative"}
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "font": "Georgia, serif"
  }
}